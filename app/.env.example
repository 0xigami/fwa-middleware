# Optional local override only. Do not set on Vercel.
# After proposal 992, paste the listing manager in the operator UI (saved on the phone).
NEXT_PUBLIC_MANAGER_ADDRESS=
NEXT_PUBLIC_START_BLOCK=

# Optional RPC override. Defaults to https://ethereum-rpc.publicnode.com
NEXT_PUBLIC_RPC=

# Reown Cloud project ID (cloud.reown.com). Required for WalletConnect on phones.
# Set this in Vercel env — do not commit a real ID.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
